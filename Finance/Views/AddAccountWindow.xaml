<Window x:Class="Finance.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="Добавление счёта" Height="400" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Новый счёт" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Банк:" />
            <ComboBox x:Name="BankComboBox" Margin="0,5,0,10" Padding="5" DisplayMemberPath="bank_name" SelectedValuePath="id_bank"/>

            <TextBlock Text="Название счёта (например, Black, Накопительный):" />
            <TextBox x:Name="AccountNameBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Номер счёта или карты (последние 4 цифры):" />
            <TextBox x:Name="AccountNumberBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Валюта:" />
            <ComboBox x:Name="CurrencyComboBox" Margin="0,5,0,15" Padding="5">
                <ComboBoxItem Content="RUB" IsSelected="True"/>
                <ComboBoxItem Content="USD"/>
                <ComboBoxItem Content="EUR"/>
            </ComboBox>

            <Button x:Name="SaveButton" Content="Сохранить счёт" Height="30" Click="SaveAccount_Click"/>
        </StackPanel>
    </Grid>
</Window>