<Window x:Class="Finance.Views.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="Новая операция" Height="520" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Добавление операции" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Дата операции:" />
            <DatePicker x:Name="DatePicker" Margin="0,5,0,10" SelectedDate="{x:Static sys:DateTime.Now}" xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

            <TextBlock Text="Счёт:" />
            <ComboBox x:Name="AccountComboBox" Margin="0,5,0,10" Padding="5" DisplayMemberPath="Display" SelectedValuePath="id_account"/>

            <TextBlock Text="Категория:" />
            <ComboBox x:Name="CategoryComboBox" Margin="0,5,0,10" Padding="5" DisplayMemberPath="Display" SelectedValuePath="id_category"/>

            <TextBlock Text="Сумма (только положительная):" />
            <TextBox x:Name="AmountBox" Margin="0,5,0,10" Padding="5" 
                     TextChanged="AmountBox_TextChanged" 
                     GotFocus="AmountBox_GotFocus" 
                     LostFocus="AmountBox_LostFocus"/>

            <TextBlock Text="Магазин/Контрагент (необязательно):" />
            <TextBox x:Name="MerchantBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Описание:" />
            <TextBox x:Name="DescriptionBox" Margin="0,5,0,15" Padding="5"/>

            <Button x:Name="SaveButton" Content="Сохранить" Height="35" Click="SaveTransaction_Click"/>
        </StackPanel>
    </Grid>
</Window>