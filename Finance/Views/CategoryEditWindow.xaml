<Window x:Class="Finance.Views.CategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.icoo"
        Title="Категория" Height="250" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Название категории:" />
            <TextBox x:Name="NameBox" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Тип категории:" />
            <ComboBox x:Name="TypeComboBox" Margin="0,5,0,15" Padding="5">
                <ComboBoxItem Content="Income" IsSelected="True"/>
                <ComboBoxItem Content="Expense"/>
                <ComboBoxItem Content="Transfer"/>
            </ComboBox>

            <Button x:Name="SaveButton" Content="Сохранить" Height="30" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>