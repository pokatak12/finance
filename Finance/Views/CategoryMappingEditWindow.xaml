<Window x:Class="Finance.Views.CategoryMappingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="Маппинг категорий банков"
        Height="300"
        Width="350"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Банк:" />

            <ComboBox x:Name="BankComboBox"
                      Margin="0,5,0,10"
                      DisplayMemberPath="bank_name"
                      SelectedValuePath="id_bank"/>

            <TextBlock Text="Название категории в банке (например, 'Супермаркеты'):" />

            <TextBox x:Name="BankCategoryBox"
                     Margin="0,5,0,10"
                     Padding="5"/>

            <TextBlock Text="Категория в системе:" />

            <ComboBox x:Name="CategoryComboBox"
                      Margin="0,5,0,15"
                      DisplayMemberPath="category_name"
                      SelectedValuePath="id_category"/>

            <Button Content="Сохранить"
                    Height="30"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>