<Window x:Class="Finance.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.icoo"
        Title="Первый запуск" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Создание администратора" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="ФИО:" />
            <TextBox x:Name="FullNameBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Логин:" />
            <TextBox x:Name="LoginBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Пароль (мин. 8 символов):" />
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,15" Padding="5"/>

            <Button Content="Создать" Height="30" Click="CreateAdmin_Click"/>
        </StackPanel>
    </Grid>
</Window>