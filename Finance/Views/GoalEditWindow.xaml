<Window x:Class="Finance.Views.GoalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="Финансовая цель" Height="450" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Название цели:" />
            <TextBox x:Name="NameBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Целевая сумма (₽):" />
            <!-- Добавлено событие TextChanged для автоформата -->
            <TextBox x:Name="TargetAmountBox" Margin="0,5,0,10" Padding="5" TextChanged="AmountBox_TextChanged"/>

            <TextBlock Text="Уже накоплено (₽):" />
            <TextBox x:Name="CurrentAmountBox" Margin="0,5,0,10" Padding="5" Text="0" TextChanged="AmountBox_TextChanged"/>

            <TextBlock Text="Дедлайн:" />
            <DatePicker x:Name="DeadlinePicker" Margin="0,5,0,10"/>

            <!-- ДОБАВЛЕН СТАТУС -->
            <TextBlock Text="Статус цели:" />
            <ComboBox x:Name="StatusComboBox" Margin="0,5,0,15" Padding="5">
                <ComboBoxItem Content="Активна" IsSelected="True"/>
                <ComboBoxItem Content="Выполнена"/>
                <ComboBoxItem Content="Отменена"/>
                <ComboBoxItem Content="Заморожена"/>
            </ComboBox>

            <Button x:Name="SaveButton" Content="Сохранить" Height="30" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>