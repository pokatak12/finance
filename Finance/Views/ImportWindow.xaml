<Window x:Class="Finance.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="Импорт выписки" Height="420" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Импорт банковской выписки (CSV)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="1. Выберите банк:" />
            <!-- ИСПРАВЛЕНО: убраны DisplayMemberPath и SelectedValuePath -->
            <ComboBox x:Name="BankComboBox" Margin="0,5,0,10" Padding="5">
                <ComboBoxItem Content="ВТБ (CSV)" Tag="2" IsSelected="True"/>
                <ComboBoxItem Content="Т-Банк (CSV)" Tag="3"/>
            </ComboBox>

            <TextBlock Text="2. Кодировка файла:" />
            <ComboBox x:Name="EncodingComboBox" Margin="0,5,0,10" Padding="5" SelectedIndex="0">
                <ComboBoxItem Content="Автоопределение (UTF-8)"/>
                <ComboBoxItem Content="Windows-1251 (Кириллица)"/>
            </ComboBox>

            <TextBlock Text="3. Выберите файл выписки (CSV):" />
            <Grid Margin="0,5,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathBox" IsReadOnly="True" Padding="5" Grid.Column="0"/>
                <Button Content="Обзор..." Padding="10,5" Margin="5,0,0,0" Grid.Column="1" Click="Browse_Click"/>
            </Grid>

            <Button x:Name="ImportButton" Content="Начать импорт" Height="40" FontWeight="Bold" Click="StartImport_Click"/>
            <ProgressBar x:Name="ProgressBar" Height="10" Margin="0,15,0,5" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>