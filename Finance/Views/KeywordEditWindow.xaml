<Window x:Class="Finance.Views.KeywordEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="Ключевое слово" Height="250" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Ключевое слово:" />
            <TextBox x:Name="KeywordBox" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Категория:" />
            <ComboBox x:Name="CategoryComboBox" Margin="0,5,0,15" Padding="5" DisplayMemberPath="category_name" SelectedValuePath="id_category"/>

            <Button x:Name="SaveButton" Content="Сохранить" Height="30" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>