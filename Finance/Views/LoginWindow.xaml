<Window x:Class="Finance.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="Вход в систему" Height="300" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Логин:" />
            <TextBox x:Name="LoginBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Пароль:" />
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,15" Padding="5"/>

            <Button Content="Войти" Height="30" Click="Login_Click"/>
            <TextBlock Text="Нет аккаунта? Зарегистрироваться" Foreground="Blue" Cursor="Hand" 
           Margin="0,15,0,0" HorizontalAlignment="Center" TextDecorations="Underline"
           MouseLeftButtonDown="GoToRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>