<Window x:Class="Finance.Views.MccEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/finico.ico"
        Title="MCC Код" Height="320" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MCC Код (4 цифры):" />
            <TextBox x:Name="MccCodeBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Категория:" />
            <ComboBox x:Name="CategoryComboBox" Margin="0,5,0,10" Padding="5" DisplayMemberPath="category_name" SelectedValuePath="id_category"/>

            <TextBlock Text="Банк (оставьте пустым для всех):" />
            <ComboBox x:Name="BankComboBox" Margin="0,5,0,15" Padding="5" DisplayMemberPath="bank_name" SelectedValuePath="id_bank"/>

            <Button x:Name="SaveButton" Content="Сохранить" Height="30" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>