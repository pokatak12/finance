<Window x:Class="Finance.Views.MerchantAliasEditWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/finico.ico"
        Title="Алиас магазина" Height="280" Width="350">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Каноническое название (как показывать):" />
            <TextBox x:Name="CanonicalBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Сырой текст из банка (как приходит):" />
            <TextBox x:Name="RawPatternBox" Margin="0,5,0,15" Padding="5"/>

            <Button Content="Сохранить" Height="30" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>