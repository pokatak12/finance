<Window x:Class="Finance.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Icon="pack://application:,,,/finico.ico"
        Title="Регистрация" Height="350" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Создание аккаунта" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="ФИО (обязательно):" />
            <TextBox x:Name="FullNameBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Логин:" />
            <TextBox x:Name="LoginBox" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Пароль (мин. 8 символов):" />
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,15" Padding="5"/>

            <Button x:Name="RegisterButton" Content="Зарегистрироваться" Height="35" Click="Register_Click"/>
        </StackPanel>
    </Grid>
</Window>